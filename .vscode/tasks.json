{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "WiFi: Connect Robot (18603-RC)",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\tools\\wifi-connect-robot.ps1",
				"-Ssid",
				"18603-RC"
			],
			"isBackground": false,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": true
			}
		},
		{
			"label": "WiFi: Status Robot (18603-RC)",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\tools\\wifi-status-robot.ps1",
				"-Ssid",
				"18603-RC"
			],
			"isBackground": false,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": true
			}
		},
		{
			"label": "ADB: Connect Robot (192.168.43.1)",
			"type": "shell",
			"command": "adb",
			"args": [
				"connect",
				"192.168.43.1:5555"
			],
			"isBackground": false,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": true
			}
		},
		{
			"label": "ADB: Capture Offline Diagnostics (192.168.43.1)",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\tools\\adb-capture-offline-diagnostics.ps1",
				"-Endpoint",
				"192.168.43.1:5555"
			],
			"isBackground": false,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": true
			}
		},
		{
			"label": "Sloth: Deploy TeamCode (deploySloth)",
			"type": "shell",
			"command": "${workspaceFolder}\\\\gradlew.bat",
			"args": [
				":TeamCode:deploySloth",
				"--no-daemon",
				"--stacktrace"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			}
		},
		{
			"label": "Sloth: Remove Remote + Deploy",
			"type": "shell",
			"command": "${workspaceFolder}\\\\gradlew.bat",
			"args": [
				":TeamCode:removeSlothRemote",
				":TeamCode:deploySloth",
				"--no-daemon",
				"--stacktrace"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			}
		},
		{
			"label": "Sloth: Full Rebuild + Deploy (TeamCode+PsiKit)",
			"type": "shell",
			"command": "${workspaceFolder}\\\\gradlew.bat",
			"args": [
				"clean",
				":TeamCode:removeSlothRemote",
				":TeamCode:deploySloth",
				"--rerun-tasks",
				"--no-daemon",
				"--stacktrace"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			}
		},
		{
			"label": "Gradle: TeamCode assembleDebug (2025_Decode)",
			"type": "shell",
			"command": "${workspaceFolder}\\\\gradlew.bat",
			"args": [
				":TeamCode:assembleDebug",
				"--no-daemon"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "APK: Install Full Debug APK (TeamCode)",
			"type": "shell",
			"command": "${workspaceFolder}\\\\gradlew.bat",
			"args": [
				":TeamCode:installDebug",
